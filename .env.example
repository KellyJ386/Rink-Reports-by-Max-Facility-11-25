# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/mfo_ice_rink?schema=public"

# ==================== AUTHENTICATION ====================
# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT Token expiration (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"

# Session cookie name
SESSION_COOKIE_NAME="auth_token"

# ==================== ENCRYPTION ====================
# Master encryption key for sensitive data (generate with: openssl rand -base64 32)
# Used for encrypting SMS credentials, API keys, etc.
ENCRYPTION_KEY="your-encryption-key-change-this-in-production-32-chars-minimum"

# ==================== APPLICATION ====================
# Application environment (development, staging, production)
NODE_ENV="development"

# Application URL (used for redirects, email links, etc.)
APP_URL="http://localhost:3000"

# API base URL (if different from APP_URL)
API_URL="http://localhost:3000/api"

# ==================== EMAIL NOTIFICATIONS ====================
# SMTP Configuration for sending emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM_NAME="MFO Ice Rink Management"
SMTP_FROM_EMAIL="noreply@example.com"

# ==================== SMS NOTIFICATIONS ====================
# Twilio Configuration (optional - for SMS notifications)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ==================== FILE STORAGE ====================
# File storage provider (local, s3, azure, gcs)
FILE_STORAGE_PROVIDER="local"

# Local file storage path
FILE_STORAGE_PATH="./uploads"

# ==================== WEBHOOKS ====================
# Webhook API key for external integrations
WEBHOOK_API_KEY="dev-webhook-key-12345-change-in-production"

# ==================== RATE LIMITING ====================
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS="900000"

# Maximum requests per window per IP
RATE_LIMIT_MAX_REQUESTS="100"

# ==================== SCHEDULED JOBS ====================
# Enable/disable scheduled report generation
ENABLE_SCHEDULED_REPORTS="true"

# Cron schedule for checking scheduled reports (default: every hour)
SCHEDULED_REPORTS_CRON="0 * * * *"

# ==================== FEATURE FLAGS ====================
# Enable PWA features
ENABLE_PWA="true"

# Enable offline support
ENABLE_OFFLINE="true"

# Enable SMS notifications
ENABLE_SMS="false"

# ==================== SECURITY ====================
# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://your-domain.com"

# Enable HTTPS redirect in production
FORCE_HTTPS="false"

# Maximum upload file size in MB
MAX_FILE_SIZE_MB="10"

# ==================== LOGGING ====================
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# Enable audit logging
ENABLE_AUDIT_LOGS="true"

# ==================== TIMEZONE ====================
# Default timezone for facility operations
DEFAULT_TIMEZONE="America/New_York"

# ==================== SUBSCRIPTION LIMITS ====================
# Trial subscription limits
TRIAL_MAX_USERS="10"
TRIAL_MAX_RINKS="2"
TRIAL_DURATION_DAYS="14"

# Basic subscription limits
BASIC_MAX_USERS="50"
BASIC_MAX_RINKS="8"

# Enterprise subscription limits (0 = unlimited)
ENTERPRISE_MAX_USERS="0"
ENTERPRISE_MAX_RINKS="0"
