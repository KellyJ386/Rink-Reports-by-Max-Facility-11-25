# ===========================================
# Max Facility Operations - Environment Config
# ===========================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mfo_dev?schema=public"

# Authentication
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Max Facility Operations"
NODE_ENV="development"

# Weather API
OPENWEATHER_API_KEY="your-api-key"

# Email Configuration
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@maxfacility.com"
SMTP_SECURE="false"

# Alternative: Resend
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@yourdomain.com"

# SMS Providers (choose one)
# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# MessageBird
MESSAGEBIRD_API_KEY=""
MESSAGEBIRD_ORIGINATOR=""

# Vonage
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM=""

# Redis (Optional - for caching/sessions)
REDIS_URL="redis://localhost:6379"

# Monitoring & Logging
SENTRY_DSN=""
LOG_LEVEL="info"

# Feature Flags
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_PUSH_NOTIFICATIONS="false"

# Air Quality Thresholds (ppm)
AIR_QUALITY_CO_WARNING="25"
AIR_QUALITY_CO_CRITICAL="35"
AIR_QUALITY_NO2_WARNING="0.5"
AIR_QUALITY_NO2_CRITICAL="1.0"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Session Configuration
SESSION_MAX_AGE="604800"
