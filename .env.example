# Database
# For local development: postgresql://postgres:postgres@localhost:5432/mfo_dev?schema=public
# For Vercel Postgres: Get from Vercel dashboard
# For Supabase: Get from Supabase project settings
# For Railway: Get from Railway dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/mfo_dev?schema=public"

# Auth - IMPORTANT: Change in production!
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production-must-be-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Weather API (Optional - for outside temperature)
# Get free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY="your-api-key"

# Email (Optional but recommended for notifications)
# Resend (recommended): https://resend.com
# SendGrid (alternative): https://sendgrid.com
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@yourdomain.com"

# SMS (Optional - for critical safety alerts)
# Twilio: https://twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# File Storage (Required for photo/signature fields)
# Cloudinary (recommended for images): https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# OR Vercel Blob (if using Vercel): https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Error Tracking (Optional - recommended for production)
# Sentry: https://sentry.io
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
