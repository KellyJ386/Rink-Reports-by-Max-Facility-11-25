// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== CORE ENTITIES ====================

model Facility {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  state     String
  zipCode   String
  country   String   @default("US")
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rinks          Rink[]
  users          User[]
  formTemplates  FormTemplate[]
  shifts         ShiftDefinition[]
  programs       Program[]
  settings       FacilitySettings?
  notifications  Notification[]
  smsLogs        SMSLog[]

  @@map("facilities")
}

model FacilitySettings {
  id         String   @id @default(cuid())
  facilityId String   @unique
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  // Retention settings (days) - 0 means indefinite
  iceDepthRetention      Int @default(1095) // 3 years
  iceOpsRetention        Int @default(1095)
  refrigerationRetention Int @default(1095)
  airQualityRetention    Int @default(1095)
  incidentRetention      Int @default(2555) // 7 years
  scheduleRetention      Int @default(1095)
  checklistRetention     Int @default(1095)

  // Air quality thresholds (customizable per facility)
  coWarningPpm           Float   @default(20)
  coEvacuationPpm        Float   @default(83)
  no2WarningPpm          Float   @default(0.3)
  no2EvacuationPpm       Float   @default(2.0)
  enableAirQualityAlerts Boolean @default(true)

  // Refrigeration thresholds (customizable per facility)
  suctionPressureMinWarning  Float   @default(20)
  suctionPressureMaxWarning  Float   @default(45)
  suctionPressureMinCritical Float   @default(15)
  suctionPressureMaxCritical Float   @default(50)
  dischargePressureMinWarning Float  @default(150)
  dischargePressureMaxWarning Float  @default(250)
  dischargePressureMinCritical Float @default(120)
  dischargePressureMaxCritical Float @default(300)
  compressorTempWarning      Float   @default(200)
  compressorTempCritical     Float   @default(250)
  brineTempMinWarning        Float   @default(14)
  brineTempMaxWarning        Float   @default(28)
  brineTempMinCritical       Float   @default(10)
  brineTempMaxCritical       Float   @default(32)
  enableRefrigerationAlerts  Boolean @default(true)

  // SMS Settings
  smsEnabled         Boolean @default(false)
  smsProvider        String? // 'twilio', 'messagebird', 'vonage'
  smsAccountSid      String? // Encrypted
  smsAuthToken       String? // Encrypted
  smsFromNumber      String? // Facility's SMS number
  smsQuietHoursStart String? // "22:00" - no non-critical SMS after this
  smsQuietHoursEnd   String? // "07:00" - resume SMS after this
  smsCriticalOverride Boolean @default(true) // Critical alerts ignore quiet hours

  @@map("facility_settings")
}

model Rink {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name        String // "Rink A", "Main Rink", "Studio"
  dimensions  String? // "200x85", "Olympic", custom
  surfaceType String   @default("ice") // ice, inline
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Ice depth diagram configuration
  iceDepthConfig Json? // Stores measurement point positions

  // Relations
  submissions           Submission[]
  iceDepthConfiguration IceDepthConfiguration?
  scheduleEntries       ScheduleEntry[]
  iceDepthReadings      IceDepthReading[]

  @@map("rinks")
}

// ==================== USER & AUTHENTICATION ====================

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  phoneVerified    Boolean         @default(false)
  smsOptIn         Boolean         @default(false)
  smsPreference    SMSPreference   @default(CRITICAL_ONLY)
  facilityId       String
  facility         Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role            @relation(fields: [roleId], references: [id])
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastLoginAt      DateTime?

  // Custom permission overrides (JSON allows per-module tweaks)
  permissionOverrides Json?

  // Relations
  submissions          Submission[]
  auditLogs            AuditLog[]
  scheduleEntries      ScheduleEntry[]
  availability         EmployeeAvailability[]
  timeOffRequests      TimeOffRequest[]
  iceDepthReadings     IceDepthReading[]

  // Schedule relations
  timeOffRequests       TimeOffRequest[]
  timeOffReviewed       TimeOffRequest[]     @relation("TimeOffReviewer")
  swapRequestsMade      ShiftSwapRequest[]   @relation("SwapRequester")
  swapRequestsReceived  ShiftSwapRequest[]   @relation("SwapTarget")
  swapRequestsManaged   ShiftSwapRequest[]   @relation("SwapManager")
  availability          EmployeeAvailability[]
  recurringShifts       RecurringShift[]

  @@map("users")
}

enum SMSPreference {
  ALL           // Receive all SMS notifications
  CRITICAL_ONLY // Only ambulance, evacuation, emergency coverage
  NONE          // No SMS (email only)
}

model Role {
  id              String  @id @default(cuid())
  facilityId      String? // null = system default role
  name            String // "General Manager", "Operator", etc.
  description     String?
  isSystemDefault Boolean @default(false)

  // Module-level permissions
  permissions Json // See Permission Structure in spec

  users User[]

  @@map("roles")
}

// ==================== FORM BUILDER ====================

model FormTemplate {
  id          String     @id @default(cuid())
  facilityId  String
  facility    Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  moduleType  ModuleType
  name        String
  description String?
  version     Int        @default(1)
  isActive    Boolean    @default(true)
  isLocked    Boolean    @default(false) // Compliance fields can't be edited

  // The form schema
  schema Json

  // Conditional logic rules
  conditionalRules Json?

  // Calculated field definitions
  calculatedFields Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String

  // Relations
  submissions       Submission[]
  previousVersionId String?
  previousVersion   FormTemplate?  @relation("FormVersions", fields: [previousVersionId], references: [id])
  nextVersions      FormTemplate[] @relation("FormVersions")

  @@map("form_templates")
}

enum ModuleType {
  ICE_DEPTH
  ICE_OPERATIONS
  REFRIGERATION
  AIR_QUALITY
  INCIDENT
  SCHEDULE
  DAILY_CHECKLIST
}

// ==================== SUBMISSIONS ====================

model Submission {
  id                      String           @id @default(cuid())
  formTemplateId          String
  formTemplate            FormTemplate     @relation(fields: [formTemplateId], references: [id])
  formVersionAtSubmission Int // Captures which version was used

  rinkId String
  rink   Rink   @relation(fields: [rinkId], references: [id])

  submittedById String
  submittedBy   User   @relation(fields: [submittedById], references: [id])

  // Universal header data
  submittedAt     DateTime @default(now())
  outsideTemp     Float?
  outsideTempUnit String   @default("F")

  // The actual form data
  data Json

  // For incidents requiring approval
  status       SubmissionStatus @default(SUBMITTED)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?

  // Offline sync tracking
  clientId String? // UUID generated on client for dedup
  syncedAt DateTime?

  // Soft delete for archival
  archivedAt DateTime?

  // Relations
  attachments Attachment[]
  auditLogs   AuditLog[]

  @@map("submissions")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Attachment {
  id           String         @id @default(cuid())
  submissionId String
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String // Which form field this belongs to
  type         AttachmentType
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String // Path in file storage
  createdAt    DateTime       @default(now())

  @@map("attachments")
}

enum AttachmentType {
  PHOTO
  SIGNATURE
  DOCUMENT
}

// ==================== PROGRAMS ====================

model Program {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name        String   // "Learn to Skate", "Public Skate", "Open Figure", etc.
  description String?
  color       String?  // For calendar/UI display
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([facilityId, isActive])
  @@map("programs")
}

// ==================== SCHEDULE ====================

model ShiftDefinition {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  rinkId      String? // null = facility-wide, or specific rink
  name        String // "Morning", "Evening", "Overnight"
  startTime   String // "06:00" (24hr format)
  endTime     String // "14:00"
  color       String? // For UI display
  breakMinutes Int     @default(0) // Unpaid break duration
  minEmployees Int     @default(1) // Minimum staff needed
  maxEmployees Int?    // Maximum staff allowed (null = unlimited)
  description  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  scheduleEntries ScheduleEntry[]
  recurringShifts RecurringShift[]

  // Staffing requirements
  minStaffRequired  Int @default(1)
  maxStaffAllowed   Int @default(5)

  // Relations
  scheduleEntries ScheduleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId])
  @@index([facilityId, isActive])
  @@map("shift_definitions")
}

model ScheduleEntry {
  id            String         @id @default(cuid())
  userId        String?        // null if open shift
  user          User?          @relation(fields: [userId], references: [id])
  shiftId       String?
  shift         ShiftDefinition? @relation(fields: [shiftId], references: [id])
  rinkId        String?
  facilityId    String
  date          DateTime       @db.Date
  startTime     String
  endTime       String
  breakMinutes  Int            @default(0)
  notes         String?
  isOpenShift   Boolean        @default(false)
  isEmergency   Boolean        @default(false)
  status        ScheduleStatus @default(DRAFT)
  waitlistUsers Json? // Array of user IDs in order
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String
  publishedAt   DateTime?
  publishedById String?
  claimedAt     DateTime? // When an open shift was claimed
  claimedById   String?   // Who claimed the shift

  // Conflict tracking
  hasConflict   Boolean        @default(false)
  conflictNotes String?

  // Relations
  swapRequests  ShiftSwapRequest[] @relation("OriginalShift")
  swapTargets   ShiftSwapRequest[] @relation("TargetShift")

  @@index([facilityId, date])
  @@index([userId, date])
  @@map("schedule_entries")
}

// Employee availability for scheduling
model EmployeeAvailability {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek  Int             // 0=Sunday, 1=Monday, etc.
  startTime  String?         // null means not available
  endTime    String?
  isAvailable Boolean        @default(true)
  notes      String?

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@map("employee_availability")
}

// Time-off requests
model TimeOffRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  reason      String?
  status      TimeOffStatus     @default(PENDING)
  reviewedById String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, status])
  @@index([startDate, endDate])
  @@map("time_off_requests")
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  FILLED
  CANCELLED
}

// ==================== TIME OFF REQUESTS ====================

model TimeOffRequest {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  facilityId  String
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  requestType TimeOffType
  reason      String?
  status      TimeOffStatus    @default(PENDING)

  // Review info
  reviewedById String?
  reviewedBy   User?           @relation("TimeOffReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

  // Hours tracking
  hoursRequested Float?
  hoursPaid      Float?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([facilityId, status])
  @@index([userId, startDate])
  @@map("time_off_requests")
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  BEREAVEMENT
  JURY_DUTY
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// ==================== SHIFT SWAP REQUESTS ====================

model ShiftSwapRequest {
  id              String           @id @default(cuid())
  requesterId     String
  requester       User             @relation("SwapRequester", fields: [requesterId], references: [id])
  originalShiftId String
  originalShift   ScheduleEntry    @relation("OriginalShift", fields: [originalShiftId], references: [id])

  // Target can be specific shift or open request
  targetShiftId   String?
  targetShift     ScheduleEntry?   @relation("TargetShift", fields: [targetShiftId], references: [id])
  targetUserId    String?          // User being asked to swap
  targetUser      User?            @relation("SwapTarget", fields: [targetUserId], references: [id])

  swapType        SwapType
  reason          String?
  status          SwapStatus       @default(PENDING_PEER)

  // Approval workflow
  peerApprovedAt  DateTime?
  managerApprovedById String?
  managerApprovedBy   User?        @relation("SwapManager", fields: [managerApprovedById], references: [id])
  managerApprovedAt   DateTime?
  managerNotes    String?

  facilityId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([facilityId, status])
  @@map("shift_swap_requests")
}

enum SwapType {
  SWAP          // Exchange shifts with another employee
  GIVEAWAY      // Give shift to someone else
  PICKUP        // Pick up an open/dropped shift
}

enum SwapStatus {
  PENDING_PEER     // Waiting for other employee to accept
  PENDING_MANAGER  // Waiting for manager approval
  APPROVED
  DENIED_PEER      // Other employee declined
  DENIED_MANAGER   // Manager denied
  CANCELLED
  EXPIRED
}

// ==================== EMPLOYEE AVAILABILITY ====================

model EmployeeAvailability {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  facilityId  String

  // Day of week (0 = Sunday, 6 = Saturday)
  dayOfWeek   Int
  startTime   String          // "06:00"
  endTime     String          // "22:00"
  isAvailable Boolean         @default(true) // false = blocked time

  // For recurring patterns
  effectiveFrom DateTime?     @db.Date
  effectiveTo   DateTime?     @db.Date

  // Preference level (for shift auto-assignment)
  preferenceLevel AvailabilityPreference @default(AVAILABLE)

  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, dayOfWeek, startTime, effectiveFrom])
  @@index([facilityId, dayOfWeek])
  @@map("employee_availability")
}

enum AvailabilityPreference {
  PREFERRED     // Employee prefers to work this time
  AVAILABLE     // Employee can work this time
  UNAVAILABLE   // Employee cannot work this time
}

// ==================== SCHEDULE TEMPLATES ====================

model ScheduleTemplate {
  id          String   @id @default(cuid())
  facilityId  String
  name        String   // "Summer Schedule", "Holiday Week"
  description String?
  isActive    Boolean  @default(true)

  // Template configuration stored as JSON
  // Array of { dayOfWeek, shiftId, userId?, minStaff, maxStaff }
  templateData Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  recurringShifts RecurringShift[]

  @@map("schedule_templates")
}

// ==================== RECURRING SHIFTS ====================

model RecurringShift {
  id          String           @id @default(cuid())
  facilityId  String
  templateId  String?
  template    ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  shiftId     String
  shift       ShiftDefinition  @relation(fields: [shiftId], references: [id])
  userId      String?          // null = open shift
  user        User?            @relation(fields: [userId], references: [id])

  // Recurrence pattern
  dayOfWeek   Int              // 0-6
  startDate   DateTime         @db.Date
  endDate     DateTime?        @db.Date // null = indefinite

  // Override times if different from shift definition
  startTime   String?
  endTime     String?

  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String

  @@index([facilityId, dayOfWeek])
  @@map("recurring_shifts")
}

// ==================== SCHEDULE PERIOD ====================

model SchedulePeriod {
  id          String           @id @default(cuid())
  facilityId  String
  name        String           // "Week of Jan 6, 2025"
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  status      SchedulePeriodStatus @default(DRAFT)

  // Publishing info
  publishedAt   DateTime?
  publishedById String?

  // Lock prevents further edits
  isLocked    Boolean          @default(false)
  lockedAt    DateTime?
  lockedById  String?

  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([facilityId, startDate])
  @@map("schedule_periods")
}

enum SchedulePeriodStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ==================== AUDIT & NOTIFICATIONS ====================

model AuditLog {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  action        AuditAction
  entityType    String // "Submission", "FormTemplate", etc.
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  PUBLISH
  SWAP_REQUEST
  SWAP_APPROVE
  SWAP_DENY
  TIME_OFF_REQUEST
  TIME_OFF_APPROVE
  TIME_OFF_DENY
}

model Notification {
  id                String           @id @default(cuid())
  facilityId        String
  facility          Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  recipientUserId   String? // null = broadcast to role
  recipientRoleId   String?
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean          @default(false)
  sentAt            DateTime         @default(now())
  readAt            DateTime?

  // Email tracking
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?

  @@map("notifications")
}

enum NotificationType {
  INCIDENT_SUBMITTED
  INCIDENT_AMBULANCE
  AIR_QUALITY_WARNING
  AIR_QUALITY_EVACUATION
  SCHEDULE_PUBLISHED
  SHIFT_OPEN
  SHIFT_EMERGENCY
  SHIFT_ASSIGNED
  SHIFT_REMOVED
  SHIFT_REMINDER
  TIME_OFF_REQUESTED
  TIME_OFF_APPROVED
  TIME_OFF_DENIED
  SWAP_REQUESTED
  SWAP_APPROVED
  SWAP_DENIED
  SWAP_PEER_RESPONSE
  SCHEDULE_CONFLICT
  REPORT_REMINDER
  SYSTEM
}

model SMSLog {
  id             String           @id @default(cuid())
  facilityId     String
  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId         String?
  phoneNumber    String
  messageType    NotificationType
  messageBody    String

  // Twilio tracking
  providerMessageId String?
  status            SMSStatus @default(QUEUED)
  statusUpdatedAt   DateTime?
  errorCode         String?
  errorMessage      String?

  // Two-way SMS
  isIncoming Boolean @default(false)
  inReplyTo  String? // Links response to original message

  sentAt      DateTime  @default(now())
  deliveredAt DateTime?

  @@map("sms_logs")
}

enum SMSStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

// ==================== ICE DEPTH SPECIFIC ====================

model IceDepthConfiguration {
  id                String          @id @default(cuid())
  rinkId            String          @unique
  rink              Rink            @relation(fields: [rinkId], references: [id], onDelete: Cascade)
  presetType        IceDepthPreset? // RINK_25, RINK_35, RINK_47, CUSTOM
  measurementPoints Json // Array of {id, x, y, label}
  backgroundImage   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("ice_depth_configurations")
}

enum IceDepthPreset {
  RINK_25 // 25 measurement points
  RINK_35 // 35 measurement points
  RINK_47 // 47 measurement points
  CUSTOM // Fully custom (up to 5 additional points)
}

// ==================== EQUIPMENT MANAGEMENT ====================

model Equipment {
  id          String          @id @default(cuid())
  facilityId  String
  name        String
  category    EquipmentCategory
  model       String?
  serialNumber String?
  manufacturer String?
  purchaseDate DateTime?
  warrantyExpiry DateTime?
  location    String?
  status      EquipmentStatus @default(OPERATIONAL)
  notes       String?
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  maintenanceRecords MaintenanceRecord[]

  @@map("equipment")
}

enum EquipmentCategory {
  RESURFACER
  REFRIGERATION
  COMPRESSOR
  EDGER
  SKATE_SHARPENER
  SAFETY_EQUIPMENT
  HVAC
  LIGHTING
  BOARDS_GLASS
  GOALS_NETS
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  NEEDS_MAINTENANCE
  UNDER_REPAIR
  OUT_OF_SERVICE
  RETIRED
}

model MaintenanceRecord {
  id            String            @id @default(cuid())
  equipmentId   String
  equipment     Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type          MaintenanceType
  priority      MaintenancePriority @default(MEDIUM)
  title         String
  description   String?
  scheduledDate DateTime?
  completedDate DateTime?
  completedById String?
  cost          Float?
  vendor        String?
  notes         String?
  status        MaintenanceStatus @default(SCHEDULED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdById   String

  @@map("maintenance_records")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  CALIBRATION
  REPLACEMENT
  EMERGENCY
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

// ==================== CHECKLIST TEMPLATES ====================

model ChecklistTemplate {
  id              String            @id @default(cuid())
  facilityId      String
  name            String
  description     String?
  category        ChecklistCategory
  frequency       ChecklistFrequency @default(ONCE)
  estimatedDuration Int             @default(30) // minutes
  sections        Json              // Array of ChecklistSection
  requiredRoles   String[]          @default([])
  isActive        Boolean           @default(true)
  version         Int               @default(1)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  instances ChecklistInstance[]

  @@map("checklist_templates")
}

enum ChecklistCategory {
  OPENING
  CLOSING
  SAFETY
  EQUIPMENT
  ICE_MAINTENANCE
  HVAC
  CLEANING
  RESURFACER
  EMERGENCY
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ChecklistFrequency {
  ONCE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model ChecklistInstance {
  id              String              @id @default(cuid())
  templateId      String
  template        ChecklistTemplate   @relation(fields: [templateId], references: [id])
  facilityId      String
  status          ChecklistStatus     @default(NOT_STARTED)
  scheduledFor    DateTime?
  dueBy           DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  assignedToId    String?
  completedById   String?
  sections        Json                // Completed sections data
  completionPercentage Int            @default(0)
  issues          Json                @default("[]") // Array of issues
  notes           String?
  signatureUrl    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("checklist_instances")
}

enum ChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  SKIPPED
}

// ==================== INCIDENT MANAGEMENT ====================

model Incident {
  id              String            @id @default(cuid())
  facilityId      String
  rinkId          String?
  reportNumber    String            @unique
  incidentDate    DateTime
  incidentTime    String
  location        String
  severity        IncidentSeverity
  status          IncidentStatus    @default(REPORTED)
  type            String
  description     String
  injuredParties  Json              @default("[]") // Array of injured party details
  witnesses       Json              @default("[]") // Array of witness details
  immediateActions String?
  rootCause       String?
  preventiveMeasures String?
  reportedById    String
  assignedToId    String?
  reviewedById    String?
  reviewedAt      DateTime?
  closedById      String?
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  followUps       IncidentFollowUp[]
  escalations     IncidentEscalation[]

  @@map("incidents")
}

enum IncidentSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  PENDING_REVIEW
  RESOLVED
  CLOSED
  REOPENED
}

model IncidentFollowUp {
  id            String          @id @default(cuid())
  incidentId    String
  incident      Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type          FollowUpType
  dueDate       DateTime
  completedDate DateTime?
  assignedToId  String?
  notes         String?
  status        FollowUpStatus  @default(PENDING)
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("incident_follow_ups")
}

enum FollowUpType {
  PHONE_CALL
  MEDICAL_CHECK
  INSURANCE_CLAIM
  INVESTIGATION
  DOCUMENTATION
  TRAINING
  EQUIPMENT_INSPECTION
  OTHER
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model IncidentEscalation {
  id          String          @id @default(cuid())
  incidentId  String
  incident    Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromLevel   EscalationLevel
  toLevel     EscalationLevel
  reason      String
  escalatedById String
  createdAt   DateTime        @default(now())

  @@map("incident_escalations")
}

enum EscalationLevel {
  STAFF
  SUPERVISOR
  MANAGER
  DIRECTOR
  EXECUTIVE
  EXTERNAL
}
